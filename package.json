{
  "name": "mongoose-guard",
  "version": "0.1.0",
  "description": "Validate request bodies against your Mongoose schemas, with per-route field allowlists and strict type checks.",
  "keywords": [
    "mongoose",
    "validation",
    "express",
    "middleware",
    "mass-assignment",
    "allowlist",
    "request-validation"
  ],
  "license": "MIT",
  "author": "Amritanshu Rai",
  "homepage": "https://amritanshurai.github.io/mongoose-guard/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmritanshuRai/mongoose-guard.git"
  },
  "bugs": {
    "url": "https://github.com/AmritanshuRai/mongoose-guard/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "express": [
        "./dist/express.d.cts"
      ],
      "web": [
        "./dist/web.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      },
      "require": {
        "types": "./dist/express.d.cts",
        "default": "./dist/express.cjs"
      }
    },
    "./web": {
      "import": {
        "types": "./dist/web.d.ts",
        "default": "./dist/web.js"
      },
      "require": {
        "types": "./dist/web.d.cts",
        "default": "./dist/web.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check:package": "publint --strict && attw --pack .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:package",
    "prepublishOnly": "pnpm verify"
  },
  "peerDependencies": {
    "@types/express": ">=4",
    "express": ">=4",
    "mongoose": ">=8"
  },
  "peerDependenciesMeta": {
    "@types/express": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.15",
    "@types/express": "5.0.6",
    "@types/node": "22",
    "@vitest/coverage-v8": "5.0.3",
    "express": "5.3.0",
    "mongoose": "9.11.1",
    "mongoose-v8": "npm:mongoose@8.24.5",
    "publint": "0.3.25",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
